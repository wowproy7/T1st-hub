                    iCollectPro.log(loadstring(base64decode("ICBzZXJ2ZXIg"))() .. n:match(loadstring(base64decode("W14vXSsvW14vXSsk"))()) .. loadstring(base64decode("OiA="))() .. table.concat(a, loadstring(base64decode("IHwg"))()))
