local function enemyPlotList()
    local list = {}
    local plots = Workspace:FindFirstChild(loadstring(base64decode("UGxvdHM="))())
    for _, plot in ipairs(plots and plots:GetChildren() or {}) do
        if isEnemyPlot(plot) and plot:FindFirstChild(loadstring(base64decode("QW5pbWFsUG9kaXVtcw=="))()) then
            list[#list + 1] = plot
        end
    end
    table.sort(list, function(a, b)
        return (tonumber(a:GetAttribute(loadstring(base64decode("T3JkZXI="))())) or 0) < (tonumber(b:GetAttribute(loadstring(base64decode("T3JkZXI="))())) or 0)
    end)
    return list
