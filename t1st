-- Grapple FX off (user's call, loadstring(base64decode("c28gaXQgbG9va3MgY29vbA=="))()): the tool's Fire / Hit sounds muted, its hook,
-- beam and rope hidden - and for a moment after firing, anything hook / rope shaped the grapple
-- spawns too. Render / volume only, on our screen; nothing is sent to the server.
function iCollectPro.hushGrapple(g, secs)
    local char = player.Character
    local function ours(d)
        return (char and d:IsDescendantOf(char)) or d:IsDescendantOf(g)
    end
    local function hush(d)
        if d:IsA(loadstring(base64decode("U291bmQ="))()) then
            d.Volume = 0
            pcall(d.Stop, d)
        elseif d:IsA(loadstring(base64decode("QmVhbQ=="))()) or d:IsA(loadstring(base64decode("VHJhaWw="))()) or d:IsA(loadstring(base64decode("UGFydGljbGVFbWl0dGVy"))()) then
            d.Enabled = false
        elseif d:IsA(loadstring(base64decode("Um9wZUNvbnN0cmFpbnQ="))()) or d:IsA(loadstring(base64decode("Um9kQ29uc3RyYWludA=="))()) then
            d.Visible = false
        elseif d:IsA(loadstring(base64decode("QmFzZVBhcnQ="))()) then
            d.LocalTransparencyModifier = 1
        end
    end
    for _, d in ipairs(g:GetDescendants()) do pcall(hush, d) end
    if not secs then return end
    local function added(d)
        local n = d.Name:lower()
        local named = n:find(loadstring(base64decode("aG9vaw=="))(), 1, true) or n:find(loadstring(base64decode("cm9wZQ=="))(), 1, true) or n:find(loadstring(base64decode("Z3JhcHBsZQ=="))(), 1, true)
        local linked = false
        if d:IsA(loadstring(base64decode("QmVhbQ=="))()) or d:IsA(loadstring(base64decode("Um9wZUNvbnN0cmFpbnQ="))()) or d:IsA(loadstring(base64decode("Um9kQ29uc3RyYWludA=="))()) then
            local a0, a1 = d.Attachment0, d.Attachment1
            linked = (a0 and ours(a0)) or (a1 and ours(a1))
        end
        -- the grapple's two clips are 16211041 (fire) / 16211030 (hit); the carpet's own effects stay
        local sound = d:IsA(loadstring(base64decode("U291bmQ="))()) and (d:IsDescendantOf(g) or tostring(d.SoundId):find(loadstring(base64decode("MTYyMTEwMw=="))(), 1, true)
            or tostring(d.SoundId):find(loadstring(base64decode("MTYyMTEwNDE="))(), 1, true))
        if named or linked or sound or d:IsDescendantOf(g) then pcall(hush, d) end
        -- the grapple's pull: logged 2026-09-29, the first ~0.3s of every flight went BACKWARDS at 100
        -- (to end 151 -> 158 -> 167) until our 400 took over. A constraint tying us to something
        -- outside our body (the hook) is that pull - switch it off; SpeedAllowance was already handed
        -- out when the grapple fired. Carpet forces sit inside our own body and are left alone.
        if d:IsA(loadstring(base64decode("Q29uc3RyYWludA=="))()) then
            local a0, a1 = d.Attachment0, d.Attachment1
            local in0, in1 = a0 and char and a0:IsDescendantOf(char), a1 and char and a1:IsDescendantOf(char)
            if a0 and a1 and in0 ~= in1 then
                pcall(function() d.Enabled = false end)
                if iCollectPro.log then iCollectPro.log(loadstring(base64decode("ICBncmFwcGxlIHB1bGwgY3V0OiA="))() .. d.ClassName .. loadstring(base64decode("IA=="))() .. d.Name) end
            elseif (in0 or in1) and iCollectPro.log then
                iCollectPro.log(loadstring(base64decode("ICBncmFwcGxlIHdpbmRvdzog"))() .. d.ClassName .. loadstring(base64decode("IA=="))() .. d.Name .. loadstring(base64decode("IChsZWZ0IG9uKQ=="))())
            end
        elseif char and d:IsDescendantOf(char) and d:IsA(loadstring(base64decode("Qm9keU1vdmVy"))()) and d.Name == loadstring(base64decode("RmxpZ2h0UG93ZXI="))() then
            -- the grapple's own pull (measured 2026-09-30: BodyVelocity ~100 toward the hook, infinite
            -- force, gone after 0.58s) - it held the first 0.6s of every flight in place. Meerko
            -- destroys it right after firing; so do we
            task.defer(function() pcall(function() d:Destroy() end) end)
            if iCollectPro.log then iCollectPro.log(loadstring(base64decode("ICBncmFwcGxlIHB1bGwgcmVtb3ZlZDogRmxpZ2h0UG93ZXI="))()) end
        elseif char and d:IsDescendantOf(char) and d:IsA(loadstring(base64decode("Qm9keU1vdmVy"))()) and iCollectPro.log then
            iCollectPro.log(loadstring(base64decode("ICBncmFwcGxlIHdpbmRvdzog"))() .. d.ClassName .. loadstring(base64decode("IA=="))() .. d.Name .. loadstring(base64decode("IGluIA=="))() .. d.Parent.Name .. loadstring(base64decode("IChsZWZ0IG9uKQ=="))())
        end
    end
    local conn = Workspace.DescendantAdded:Connect(function(d) task.defer(added, d) end)
    task.delay(secs, function() conn:Disconnect() end)
end

