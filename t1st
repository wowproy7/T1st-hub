    local swapped = not stealing() and iCollectPro.quantumClone()
    local swapT = os.clock()
    hold:Destroy()
    L(string.format(loadstring(base64decode("Y2xvbmUgcmVzdWx0PSVzICBwb2QgZGlzdCAlLjFmICBzdGVhbGluZz0lcw=="))(), tostring(swapped), podDist(), tostring(stealing())))
