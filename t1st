    for _, n in ipairs({ loadstring(base64decode("QmxhY2tob2xlIEJvbWI="))(), loadstring(base64decode("Qmxvd0RyeWVy"))(), loadstring(base64decode("Q2FuZHkgTGF1bmNoZXI="))(), loadstring(base64decode("Q2FuZHljYW5lIEJvdw=="))(), loadstring(base64decode("Q2hyaXN0bWFzIExhdW5jaGVy"))(),
        loadstring(base64decode("RnJlZXplIFJheQ=="))(), loadstring(base64decode("R3Jhdml0eSBHdW4="))(), loadstring(base64decode("SHVudGVyIENyb3NzYm93"))(), loadstring(base64decode("SmVsbHkgR3Vu"))(), loadstring(base64decode("TGFzZXIgQ2FwZQ=="))(), loadstring(base64decode("TGF2YSBCbGFzdGVy"))(), loadstring(base64decode("UGFpbnRiYWxsIEd1bg=="))(),
        loadstring(base64decode("UHVtcGtpbiBMYXVuY2hlcg=="))(), loadstring(base64decode("UmFkaW9hY3RpdmUgQWlyc3RyaWtl"))(), loadstring(base64decode("U2FidWsgQmVwYWs="))(), loadstring(base64decode("U2FuZGFsIEplcGl0"))(), loadstring(base64decode("U2xpbmdzaG90"))(), loadstring(base64decode("U25vd2JhbGw="))(),
        loadstring(base64decode("U25vd2JhbGwgQ2Fubm9u"))(), loadstring(base64decode("U3VtbWVyIFNvYWtlcg=="))(), loadstring(base64decode("U3VwZXItR0xTMzM="))(), loadstring(base64decode("VGFzZXIgR3Vu"))(), loadstring(base64decode("VHJpcHBsZSBQbHVuZ2Vycw=="))(), loadstring(base64decode("V2ViIFNsaW5nZXI="))(),
        loadstring(base64decode("V29ybWhvbGUgVHVubmVsZXI="))(), loadstring(base64decode("Wm9tYmllIEJsYXN0ZXI="))() }) do AIM_ITEMS[n] = true end
    local mouse
    pcall(function() mouse = require(ReplicatedStorage.Packages.PlayerMouse) end)
    local aimAt, lastScan, lastShot = nil, 0, 0
    local function aimStep()
        if not (iCollectProFx.aim and mouse) then aimAt = nil return end
        local ch = LP.Character
        local hrp = ch and ch:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
        local tool = ch and ch:FindFirstChildOfClass(loadstring(base64decode("VG9vbA=="))())
        if not (hrp and tool and AIM_ITEMS[tool.Name]) then aimAt = nil return end
        if not aimAt or not aimAt.Parent or os.clock() - lastScan >= 0.05 then
            lastScan = os.clock()
            local best, bestD = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                local r = p ~= LP and p.Character and p.Character:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
                local h = r and p.Character:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
                if r and h and h.Health > 0 then
                    local d = (r.Position - hrp.Position).Magnitude
                    if d < bestD then best, bestD = r, d end
                end
            end
            aimAt = best
        end
        if aimAt then
            pcall(function() mouse.Hit = CFrame.new(aimAt.Position); mouse.Target = aimAt end)
            if iCollectProFx.spam and os.clock() - lastShot >= 0.1 then
