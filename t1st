            over = false
            to(1, 0.12)
        end)
    end
    for _, gui in ipairs({ ScreenGui, SpeedScreenGui, AllowDisallowGui, ProgressGui }) do
        for _, d in ipairs(gui:GetDescendants()) do hook(d) end
