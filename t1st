                    or (obj:IsA(loadstring(base64decode("QXR0YWNobWVudA=="))()) and (obj.Name == loadstring(base64decode("QQ=="))() or obj.Name == loadstring(base64decode("Qg=="))())) then
                    obj:Destroy()
                elseif obj:IsA(loadstring(base64decode("Qm9keVZlbG9jaXR5"))()) or obj:IsA(loadstring(base64decode("Qm9keVBvc2l0aW9u"))()) or obj:IsA(loadstring(base64decode("Qm9keUd5cm8="))()) then
