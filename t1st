                            iCollectPro.log(string.format(loadstring(base64decode("ICB0b3VjaGVkICVzICAoJXMsIGNvbGxpZGU9JXMp"))(), o:GetFullName():sub(-70),
                                o.ClassName, tostring(o.CanCollide)))
