local function cycleBase(dir)
    local list = enemyPlotList()
    local idx = 0
    for BkWaBK9g, p in ipairs(list) do
        if p == targetPlot then idx = BkWaBK9g break end
    end
    idx = (idx + dir) % (#list + 1)
    targetPlot = list[idx]
    refreshBaseName()
end

