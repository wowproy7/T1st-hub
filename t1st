                elseif obj:IsA(loadstring(base64decode("QmFzZVBhcnQ="))()) then
                    for _, child in ipairs(obj:GetChildren()) do
                        if child:IsA(loadstring(base64decode("TW90b3I2RA=="))()) then
                            child.Enabled = true
                        elseif child:IsA(loadstring(base64decode("QmFsbFNvY2tldENvbnN0cmFpbnQ="))()) or child:IsA(loadstring(base64decode("Tm9Db2xsaXNpb25Db25zdHJhaW50"))()) or child:IsA(loadstring(base64decode("SGluZ2VDb25zdHJhaW50"))()) then
                            child:Destroy()
                        elseif child:IsA(loadstring(base64decode("QXR0YWNobWVudA=="))()) and (child.Name == loadstring(base64decode("QQ=="))() or child.Name == loadstring(base64decode("Qg=="))()) then
                            child:Destroy()
