                    minDist = dist
                    nearestPos = pos
                end
            end
        end
    end

    if not nearestPos then
        for _, d in pairs(Workspace:GetDescendants()) do
            if d.Name == loadstring(base64decode("RGVsaXZlcnlIaXRib3g="))() then
                local pos = d:IsA(loadstring(base64decode("QmFzZVBhcnQ="))()) and d.Position or (d:IsA(loadstring(base64decode("TW9kZWw="))()) and d:GetPivot().Position)
                if pos then
                    local dist = (pos - refPos).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearestPos = pos
                    end
                end
            end
        end
    end

    return nearestPos
end

