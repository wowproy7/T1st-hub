--   <username> over anyone else standing inside YOUR base: INSIDE YOUR BASE !! / STEALING loadstring(base64decode("PGJyYWlucm90Pg=="))()
do
    local function makePill(name, titleText)
        local bb = Instance.new(loadstring(base64decode("QmlsbGJvYXJkR3Vp"))())
        bb.Name = name
        -- pixel-sized (no scale part), so it is this exact size on screen at any distance or zoom
